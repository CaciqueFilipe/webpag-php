{
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/phpunit*)",
      "Bash(composer test*)",
      "Bash(composer check-platform-reqs)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ]
  },
  "env": {
    "XDEBUG_MODE": "off"
  }
}